# Copy to .env and fill real values. .env is gitignored and never committed.

# --- Postgres ---
POSTGRES_USER=alix
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=alix
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend reads this; host tools use localhost:5433 (see docker-compose port map).
DATABASE_URL=postgresql+psycopg://alix:change_me_local_only@db:5432/alix

# --- Ingestion crawler etiquette ---
CRAWLER_USER_AGENT=AlixIntelligence-Assessment/0.1 (+contact: muhammad.a107@turing.com)
CRAWLER_RATE_LIMIT_RPS=1

# --- LLM provider (abstracted; app/services/llm/) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
